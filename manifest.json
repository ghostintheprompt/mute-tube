{
  "manifest_version": 3,
  "name": "Mute Tube",
  "version": "2.1.0",
  "description": "Mutes YouTube ads with a narrow, auditable Manifest V3 extension.",

  "permissions": [
    "activeTab",
    "storage"
  ],

  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; connect-src 'none'; style-src 'self'; img-src 'self' data:;"
  },

  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://music.youtube.com/*"
      ],
      "js": ["src/content/content.js"],
      "run_at": "document_end"
    }
  ],

  "background": {
    "service_worker": "src/background/background.js"
  },

  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Mute Tube",
    "default_icon": {
      "128": "mute_tube.png"
    }
  },

  "icons": {
    "128": "mute_tube.png"
  }
}
